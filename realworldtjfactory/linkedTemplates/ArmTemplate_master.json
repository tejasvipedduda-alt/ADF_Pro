{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "realworldtjfactory"
		},
		"ls_cdc_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'ls_cdc'"
		},
		"ls_database_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'ls_database'"
		},
		"ls_onprem_files_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'ls_onprem_files'"
		},
		"ls_cdc_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://adlsdatalaketj.dfs.core.windows.net/"
		},
		"ls_database_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "adfproservertj.database.windows.net"
		},
		"ls_database_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "prodatabase"
		},
		"ls_database_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "proadmin"
		},
		"ls_onprem_files_properties_typeProperties_host": {
			"type": "string",
			"defaultValue": "\\\\localhost\\c$\\Tejasvionprem"
		},
		"ls_onprem_files_properties_typeProperties_userId": {
			"type": "string",
			"defaultValue": ".\\adfuser"
		},
		"ls_restapi_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://pokeapi.co/api/v2/pokemon"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "realworldtjfactory_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"ls_cdc_accountKey": {
						"value": "[parameters('ls_cdc_accountKey')]"
					},
					"ls_database_password": {
						"value": "[parameters('ls_database_password')]"
					},
					"ls_onprem_files_password": {
						"value": "[parameters('ls_onprem_files_password')]"
					},
					"ls_cdc_properties_typeProperties_url": {
						"value": "[parameters('ls_cdc_properties_typeProperties_url')]"
					},
					"ls_database_properties_typeProperties_server": {
						"value": "[parameters('ls_database_properties_typeProperties_server')]"
					},
					"ls_database_properties_typeProperties_database": {
						"value": "[parameters('ls_database_properties_typeProperties_database')]"
					},
					"ls_database_properties_typeProperties_userName": {
						"value": "[parameters('ls_database_properties_typeProperties_userName')]"
					},
					"ls_restapi_properties_typeProperties_url": {
						"value": "[parameters('ls_restapi_properties_typeProperties_url')]"
					},
					"ls_onprem_files_properties_typeProperties_host": {
						"value": "[parameters('ls_onprem_files_properties_typeProperties_host')]"
					},
					"ls_onprem_files_properties_typeProperties_userId": {
						"value": "[parameters('ls_onprem_files_properties_typeProperties_userId')]"
					}
				}
			},
			"dependsOn": []
		},
		{
			"name": "realworldtjfactory_ArmTemplate_1",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_1.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					}
				}
			},
			"dependsOn": [
				"[resourceId('Microsoft.Resources/deployments', 'realworldtjfactory_ArmTemplate_0')]"
			]
		}
	]
}